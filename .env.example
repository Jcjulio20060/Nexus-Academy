# Banco de dados (PostgreSQL)
DATABASE_URL="postgres://..."

# Senha do administrador (exigida pelo seed)
ADMIN_PASSWORD="SuaSenhaForteAqui"

# Chave da API OpenWeatherMap
API_KEY_WEATHER="SuaChaveDaAPIAqui"

# Email que recebe as notificacoes de novas solicitacoes
ADMIN_EMAIL="seuemail@exemplo.com"

# Envio de email (Resend). Para enviar a alunos, verifique um dominio no Resend
# e use EMAIL_FROM com ele (ex.: "Coffee & Code <no-reply@seudominio.com>").
API_KEY_RESEND="re_..."
EMAIL_FROM="Coffee & Code <onboarding@resend.dev>"

# Telegram (bot criado no @BotFather). O chat id do admin vem de
# https://api.telegram.org/bot<TOKEN>/getUpdates. O webhook secret e uma senha
# sua (gere com: openssl rand -hex 32).
TELEGRAM_BOT_TOKEN="123456789:..."
TELEGRAM_ADMIN_CHAT_ID="123456789"
TELEGRAM_WEBHOOK_SECRET="SeuSegredoDoWebhookAqui"

# Segredo para assinar a sessao do admin (gere com: openssl rand -hex 32)
SESSION_SECRET="SeuSegredoLongoAqui"

# Notificacoes push (gere com: npx web-push generate-vapid-keys --json)
VAPID_PUBLIC_KEY="SuaChavePublicaAqui"
VAPID_PRIVATE_KEY="SuaChavePrivadaAqui"
VAPID_SUBJECT="mailto:seuemail@exemplo.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="SuaChavePublicaAqui"

# Uploads de arquivos em producao (Vercel Blob). Sem isso, salva localmente.
# BLOB_READ_WRITE_TOKEN=""
