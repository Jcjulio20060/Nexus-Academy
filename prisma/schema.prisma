// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClassSession {
  id          Int       @id @default(autoincrement())
  day         String    // Monday, Tuesday...
  period      Int?
  start       String    // HH:MM
  end         String    // HH:MM
  
  subjectId   Int
  subject     Subject   @relation(fields: [subjectId], references: [id])
  
  professorId Int
  professor   Professor @relation(fields: [professorId], references: [id])
  
  room        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id        Int      @id @default(autoincrement())
  title     String
  date      String   // YYYY-MM-DD
  type      String   // exam, assignment, holiday, other
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id        Int      @id @default(autoincrement())
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Representative {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   // "Representante" ou "Vice-Representante"
  contact   String?  // WhatsApp
  email     String?
  password  String?  // hash para acesso ao painel admin
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id            Int           @id @default(autoincrement())
  subject       String
  category      String        @default("GERAL") // GERAL, ACADEMICO, TECNICO, OUTRO
  message       String
  status        String        @default("OPEN") // OPEN, CLOSED
  attachmentUrl String?
  fileName      String?
  studentId     Int
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  replies       TicketReply[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model TicketReply {
  id        Int      @id @default(autoincrement())
  message   String
  isAdmin   Boolean  @default(false)
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AbsenceJustification {
  id            Int      @id @default(autoincrement())
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     Int?
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  date          String   // YYYY-MM-DD
  reason        String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote     String?
  attachmentUrl String?
  fileName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Student {
  id            Int                   @id @default(autoincrement())
  name          String
  registration  String                @unique
  email         String?

  tickets       Ticket[]
  absences      AbsenceJustification[]
  subscriptions PushSubscription[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  type      String   @default("LINK") // LINK ou FILE
  fileName  String?

  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  code      String?   // Optional code like "MAT01"
  period    String?   // Semester/period like "2026/2"
  
  classes   ClassSession[]
  resources Resource[]
  absences  AbsenceJustification[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Professor {
  id        Int            @id @default(autoincrement())
  name      String
  email     String?
  
  classes   ClassSession[]
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}
