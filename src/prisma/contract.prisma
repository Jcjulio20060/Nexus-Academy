// use prisma-next

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  STAFF
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum EnrollmentStatus {
  ENROLLED
  WAITLISTED
  DROPPED
  COMPLETED
}

enum FileCategory {
  MATERIAL
  DOCUMENT
  ANNOUNCEMENT
  OTHER
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ImportantDateCategory {
  EXAM
  PROJECT
  ACTIVITY
  DEADLINE
  EVENT
  OTHER
}

enum NoticeCategory {
  GENERAL
  ALERT
  MAINTENANCE
  REMINDER
}

enum NoticeAudience {
  ALL
  STUDENTS
  TEACHERS
  STAFF
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  username     String?    @unique
  passwordHash String?
  name         String?
  role         UserRole   @default(STUDENT)
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt  temporal.updatedAt()

  aluno      Aluno?
  professor  Professor?
  arquivos   Arquivo[]  @relation("UploadedFiles")
  ticketsRequested Ticket[]       @relation("RequesterTickets")
  ticketsAssigned  Ticket[]       @relation("AssignedTickets")
  ticketMessages   TicketMessage[]
  notices          Notice[]
  importantDates   ImportantDate[]
  reviewedAbsences AbsenceJustification[] @relation("ReviewedAbsences")
}

model Aluno {
  id                 Int          @id @default(autoincrement())
  user               User         @relation(fields: [userId], references: [id])
  userId             Int          @unique
  registrationNumber String       @unique
  course             String
  year               Int
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())

  matriculas         Matricula[]
  documentos         Arquivo[]    @relation("AlunoArquivos")
}

model Professor {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int          @unique
  employeeNumber String       @unique
  department     String
  bio            String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  cadeiras       Cadeira[]
  horarios       Horario[]
  documentos     Arquivo[]    @relation("ProfessorArquivos")
}

model Cadeira {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  title       String
  description String?
  credits     Int?
  semester    Int?
  teacher     Professor?   @relation(fields: [teacherId], references: [id])
  teacherId   Int?
  createdAt   DateTime     @default(now())

  horarios    Horario[]
  matriculas  Matricula[]
  arquivos    Arquivo[]    @relation("CadeiraArquivos")
}

model Horario {
  id          Int        @id @default(autoincrement())
  cadeira     Cadeira    @relation(fields: [cadeiraId], references: [id])
  cadeiraId   Int
  professor   Professor? @relation(fields: [professorId], references: [id])
  professorId Int?
  day         Weekday
  startTime   String
  endTime     String
  location    String?
  createdAt   DateTime   @default(now())
}

model Matricula {
  id            Int             @id @default(autoincrement())
  aluno         Aluno           @relation(fields: [alunoId], references: [id])
  alunoId       Int
  cadeira       Cadeira         @relation(fields: [cadeiraId], references: [id])
  cadeiraId     Int
  status        EnrollmentStatus @default(ENROLLED)
  enrolledAt    DateTime         @default(now())
  grade         Float?

  @@unique([alunoId, cadeiraId])
}

model Arquivo {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  url           String
  category      FileCategory @default(MATERIAL)
  visible       Boolean      @default(true)
  uploadedAt    DateTime     @default(now())
  uploadedBy    User?        @relation("UploadedFiles", fields: [uploadedById], references: [id])
  uploadedById  Int?
  aluno         Aluno?       @relation("AlunoArquivos", fields: [alunoId], references: [id])
  alunoId       Int?
  professor     Professor?   @relation("ProfessorArquivos", fields: [professorId], references: [id])
  professorId   Int?
  cadeira       Cadeira?     @relation("CadeiraArquivos", fields: [cadeiraId], references: [id])
  cadeiraId     Int?
}

model Ticket {
  id            Int            @id @default(autoincrement())
  subject       String
  description   String?
  requester     User           @relation("RequesterTickets", fields: [requesterId], references: [id])
  requesterId   Int
  assignedTo    User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])
  assignedToId  Int?
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  createdAt     DateTime       @default(now())
  updatedAt     temporal.updatedAt()

  messages      TicketMessage[]
}

model TicketMessage {
  id         Int      @id @default(autoincrement())
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  ticketId   Int
  sender     User     @relation(fields: [senderId], references: [id])
  senderId   Int
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ImportantDate {
  id                Int                    @id @default(autoincrement())
  title             String
  description       String?
  category          ImportantDateCategory @default(OTHER)
  date              DateTime
  endDate           DateTime?
  allDay            Boolean               @default(true)
  location          String?
  relatedCadeira    Cadeira?              @relation(fields: [relatedCadeiraId], references: [id])
  relatedCadeiraId  Int?
  createdBy         User?                 @relation(fields: [createdById], references: [id])
  createdById       Int?
  createdAt         DateTime              @default(now())
  visible           Boolean               @default(true)
}

model Notice {
  id           Int             @id @default(autoincrement())
  title        String
  content      String
  category     NoticeCategory  @default(GENERAL)
  audience     NoticeAudience  @default(ALL)
  isPinned     Boolean         @default(false)
  visible      Boolean         @default(true)
  publishedAt  DateTime        @default(now())
  expiresAt    DateTime?
  createdBy    User?           @relation(fields: [createdById], references: [id])
  createdById  Int?
}

model FAQ {
  id          Int      @id @default(autoincrement())
  question    String
  answer      String
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model AbsenceJustification {
  id             Int           @id @default(autoincrement())
  aluno          Aluno         @relation(fields: [alunoId], references: [id])
  alunoId        Int
  submittedAt    DateTime      @default(now())
  startDate      DateTime
  endDate        DateTime
  reason         String
  proofUrl       String?
  status         AbsenceStatus @default(PENDING)
  reviewedBy     User?         @relation("ReviewedAbsences", fields: [reviewedById], references: [id])
  reviewedById   Int?
  reviewedAt     DateTime?
  response       String?
}
